# ---------------------------------------------------------------------------
# Sweet Gonz Kiosk - environment template
# Copy to `.env` and adjust values. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Database provider. Keep sqlite for the rollback/local-only path; use
# postgres for the shared local-primary/cloud-fallback deployment.
DATABASE_PROVIDER=sqlite
DATABASE_URL=
# Optional separate migration-owner URL for hosted PostgreSQL. When absent,
# db:migrate falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
PGSSL=true
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=8000
DEPLOYMENT_ID=local-primary
SERVE_WEB=true
# Comma-separated browser origins allowed to submit cookie-backed mutations.
PUBLIC_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Absolute or workspace-relative path to the SQLite database file. Ignored by
# the PostgreSQL provider but retained for rollback and local recovery tools.
# The live database must never live on a network share.
DB_PATH=./data/kiosk.db

# --- Sessions / security ----------------------------------------------------
# REQUIRED in production (min 32 characters). In development only, a random
# secret is generated at startup when this is missing (sessions do not survive
# a server restart in that case).
SESSION_SECRET=<generate-a-random-secret-locally>

# Cookie Secure flag. Keep false for plain-HTTP localhost development.
# Production/pilot mode (NODE_ENV=production) FAILS TO START unless this is
# exactly "true" (HTTPS is terminated by Caddy or the hosted proxy).
COOKIE_SECURE=false

# Set "true" when running behind Caddy, Render, or another trusted HTTPS
# reverse proxy. Required in production mode for secure cookies.
TRUST_PROXY=false

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- Rate limiting (optional overrides) --------------------------------------
# General API limiter
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
# Login limiter: max failed attempts per IP+username pair per window
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
