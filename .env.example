# ---------------------------------------------------------------------------
# Sweet Gonz Kiosk - environment template
# Copy to `.env` and adjust values. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Absolute or workspace-relative path to the SQLite database file.
# The live database must never live on a network share.
DB_PATH=./data/kiosk.db

# --- Sessions / security ----------------------------------------------------
# REQUIRED in production (min 32 characters). In development only, a random
# secret is generated at startup when this is missing (sessions do not survive
# a server restart in that case).
SESSION_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef

# Cookie Secure flag. Keep false for plain-HTTP localhost development.
# Production/pilot mode (NODE_ENV=production) FAILS TO START unless this is
# exactly "true" (HTTPS is terminated by Caddy in front of Node).
COOKIE_SECURE=false

# Set "true" when running behind Caddy (production/pilot). Required in
# production mode so req.ip and secure cookies behave correctly.
TRUST_PROXY=false

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- Rate limiting (optional overrides) --------------------------------------
# General API limiter
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
# Login limiter: max failed attempts per IP+username pair per window
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
